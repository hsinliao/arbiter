<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 https://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>distribution</id>
    <formats>
        <format>tar.gz</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>arbiter-${project.version}</baseDirectory>

    <fileSets>
        <fileSet>
            <directory>${project.basedir}/bin</directory>
            <includes>
                <include>arbiter</include>
            </includes>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/bin</directory>
            <includes>
                <include>arbiter.bat</include>
            </includes>
            <outputDirectory>bin</outputDirectory>
            <lineEnding>crlf</lineEnding>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/bin</directory>
            <includes>
                <include>server-start</include>
            </includes>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/bin</directory>
            <includes>
                <include>server-start.bat</include>
            </includes>
            <outputDirectory>bin</outputDirectory>
            <lineEnding>crlf</lineEnding>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/bin</directory>
            <includes>
                <include>server-stop</include>
            </includes>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/bin</directory>
            <includes>
                <include>server-stop.bat</include>
            </includes>
            <outputDirectory>bin</outputDirectory>
            <lineEnding>crlf</lineEnding>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/bin</directory>
            <includes>
                <include>_arbiter-common.sh</include>
            </includes>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/bin</directory>
            <includes>
                <include>_arbiter-common.bat</include>
            </includes>
            <outputDirectory>bin</outputDirectory>
            <lineEnding>crlf</lineEnding>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/conf</directory>
            <outputDirectory>conf</outputDirectory>
            <fileMode>0644</fileMode>
            <excludes>
                <exclude>cli-jvm.options</exclude>
            </excludes>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/conf</directory>
            <includes>
                <include>cli-jvm.options</include>
            </includes>
            <outputDirectory>conf</outputDirectory>
            <lineEnding>crlf</lineEnding>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/../arbiter-server/arbiter-console/target/server-lib</directory>
            <outputDirectory>lib/3rd</outputDirectory>
            <fileMode>0644</fileMode>
        </fileSet>
    </fileSets>

    <dependencySets>
        <dependencySet>
            <outputDirectory>lib/cli</outputDirectory>
            <outputFileNameMapping>${artifact.artifactId}.${artifact.extension}</outputFileNameMapping>
            <useProjectArtifact>false</useProjectArtifact>
            <useTransitiveDependencies>false</useTransitiveDependencies>
            <scope>runtime</scope>
            <fileMode>0644</fileMode>
            <includes>
                <include>io.github.arbiter:arbiter-cli-launcher</include>
                <include>io.github.arbiter:arbiter-core</include>
                <include>io.github.arbiter:arbiter-command</include>
                <include>io.github.arbiter:arbiter-client</include>
                <include>io.github.arbiter:arbiter-shell</include>
                <include>info.picocli:picocli</include>
                <include>info.picocli:picocli-shell-jline3</include>
                <include>org.jline:jline</include>
            </includes>
        </dependencySet>
        <dependencySet>
            <outputDirectory>lib/bootstrap</outputDirectory>
            <outputFileNameMapping>arbiter-control.jar</outputFileNameMapping>
            <useProjectArtifact>false</useProjectArtifact>
            <useTransitiveDependencies>false</useTransitiveDependencies>
            <scope>runtime</scope>
            <fileMode>0644</fileMode>
            <includes>
                <include>io.github.arbiter:arbiter-control</include>
            </includes>
        </dependencySet>
        <dependencySet>
            <outputDirectory>lib/bootstrap</outputDirectory>
            <outputFileNameMapping>arbiter-console.jar</outputFileNameMapping>
            <useProjectArtifact>false</useProjectArtifact>
            <useTransitiveDependencies>false</useTransitiveDependencies>
            <scope>runtime</scope>
            <fileMode>0644</fileMode>
            <includes>
                <include>io.github.arbiter:arbiter-console</include>
            </includes>
        </dependencySet>
        <dependencySet>
            <outputDirectory>lib</outputDirectory>
            <outputFileNameMapping>${artifact.artifactId}.${artifact.extension}</outputFileNameMapping>
            <useProjectArtifact>false</useProjectArtifact>
            <useTransitiveDependencies>false</useTransitiveDependencies>
            <scope>runtime</scope>
            <fileMode>0644</fileMode>
            <includes>
                <include>io.github.arbiter:arbiter-api</include>
            </includes>
        </dependencySet>
    </dependencySets>
</assembly>
