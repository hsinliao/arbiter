<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.arbiter</groupId>
        <artifactId>arbiter</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>arbiter-distribution</artifactId>
    <packaging>pom</packaging>
    <name>ARBITER DISTRIBUTION</name>

    <dependencies>
        <dependency>
            <groupId>io.github.arbiter</groupId>
            <artifactId>arbiter-cli-launcher</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.arbiter</groupId>
            <artifactId>arbiter-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.arbiter</groupId>
            <artifactId>arbiter-cli-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.arbiter</groupId>
            <artifactId>arbiter-cli-command</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.arbiter</groupId>
            <artifactId>arbiter-cli-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.arbiter</groupId>
            <artifactId>arbiter-cli-shell</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.arbiter</groupId>
            <artifactId>arbiter-control</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.arbiter</groupId>
            <artifactId>arbiter-console</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli-shell-jline3</artifactId>
            <version>${picocli.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline</artifactId>
            <version>${jline.version}</version>
        </dependency>

        <!-- arbiter-agent -->
        <dependency>
            <groupId>io.github.arbiter</groupId>
            <artifactId>arbiter-agent-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>io.github.arbiter</groupId>
            <artifactId>arbiter-agent-llm</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>io.github.arbiter</groupId>
            <artifactId>arbiter-agent-memory</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>io.github.arbiter</groupId>
            <artifactId>arbiter-agent-plugin</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>io.github.arbiter</groupId>
            <artifactId>arbiter-agent-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>io.github.arbiter</groupId>
            <artifactId>arbiter-agent-spi</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>io.github.arbiter</groupId>
            <artifactId>arbiter-agent-tool</artifactId>
            <version>${project.version}</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <finalName>arbiter-${project.version}</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                    <attach>false</attach>
                    <tarLongFileMode>posix</tarLongFileMode>
                </configuration>
                <executions>
                    <execution>
                        <id>distribution</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/distribution.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
